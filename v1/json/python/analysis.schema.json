      "required": [
        "module",
        "name"
      ],
      "title": "PyImport",
      "type": "object"
    },
    "PyModule": {
      "description": "Represents a Python module.",
      "properties": {
        "file_path": {
          "title": "File Path",
          "type": "string"
        },
        "module_name": {
          "title": "Module Name",
          "type": "string"
        },
        "imports": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PyImport"
          },
