        },
        "classes": {
          "additionalProperties": {
            "$ref": "#/$defs/PyClass"
          },
          "default": {},
          "title": "Classes",
          "type": "object"
        },
        "functions": {
          "additionalProperties": {
            "$ref": "#/$defs/PyCallable"
          },
          "default": {},
          "title": "Functions",
